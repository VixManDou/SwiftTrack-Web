<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SwiftTrack Web — Dashboard Administrador</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      :root{ --c1:#11282e; --c2:#0e535f; --c3:#0a8c9d; --c4:#05d6e8; --c5:#0ffff8; --c6:#e2e2e2; }
      .btn-brand { background: linear-gradient(90deg,var(--c4),var(--c5)); color: var(--c1); box-shadow: 0 10px 30px rgba(5,214,232,0.12); }
      .card { border: 1px solid rgba(17,40,46,0.06); background: linear-gradient(180deg, #ffffff 0%, #fbfdfd 100%); }
      .soft-shadow { box-shadow: 0 8px 30px rgba(2,6,23,0.06); }
      .brand-bg { background: linear-gradient(90deg, var(--c1) 0%, var(--c2) 40%, var(--c3) 100%); }
    </style>
  </head>
  <body class="bg-gradient-to-b from-white to-gray-50 min-h-screen antialiased text-gray-800">
    <header class="brand-bg text-white sticky top-0 z-30">
      <div class="max-w-7xl mx-auto py-4 px-6 flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold">SwiftTrack Admin</h1>
          <p class="text-xs text-white/80">Panel de control del administrador</p>
        </div>
        <nav class="text-sm">
          <a href="/" class="text-white/90 hover:underline">Inicio</a>
        </nav>
      </div>
    </header>

    <main class="max-w-7xl mx-auto p-6">
      <section class="mb-8">
        <div class="bg-white rounded-3xl shadow-lg p-8 card soft-shadow">
          <h2 class="text-3xl font-semibold text-slate-900">Bienvenido, administrador</h2>
          <p class="mt-3 text-gray-600">Desde este panel puedes revisitar el estado de los paquetes, actualizar operaciones y supervisar la trazabilidad de cada envío.</p>
        </div>
      </section>

      <section class="grid lg:grid-cols-3 gap-6 mb-10">
        <div class="lg:col-span-2 bg-white rounded-3xl p-6 card soft-shadow">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-xl font-semibold color1">Panel administrativo</h3>
              <p class="text-sm text-gray-500">Listado de envíos registrados y estado vigente.</p>
            </div>
            <span class="text-sm text-gray-500">Total: <strong><%= paquetes ? paquetes.length : 0 %></strong></span>
          </div>

          <% if (mensaje) { %>
            <% const esMensajeEliminacion = typeof mensaje === 'string' && mensaje.toLowerCase().includes('eliminado'); %>
            <div class="mb-4 rounded-2xl border <%= esMensajeEliminacion ? 'border-red-200 bg-red-50 text-red-800' : 'border-emerald-100 bg-emerald-50 text-emerald-800' %> p-4 text-sm">
              <%= mensaje %>
            </div>
          <% } %>

          <div class="mb-6 rounded-3xl border border-slate-200 p-5 bg-slate-50">
            <h4 class="text-lg font-semibold text-slate-900">Crear nuevo paquete</h4>
            <form action="/admin/crear?rol=admin&auth=true" method="POST" class="grid gap-4 mt-4">
              <div>
                <label class="block text-sm font-medium text-slate-700">Folio</label>
                <input name="folio" type="text" placeholder="ST-1006" class="w-full border rounded-xl px-4 py-3 mt-2 focus:outline-none focus:ring-2 focus:ring-sky-300" />
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700">Destino</label>
                <select name="destino" class="w-full border rounded-xl px-4 py-3 mt-2 focus:outline-none focus:ring-2 focus:ring-sky-300">
                  <% paqueteriasCatalog.forEach(function(option) { %>
                    <option value="<%= option %>"><%= option %></option>
                  <% }); %>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700">Peso (kg)</label>
                <input name="peso" type="number" step="0.1" placeholder="2.5" class="w-full border rounded-xl px-4 py-3 mt-2 focus:outline-none focus:ring-2 focus:ring-sky-300" />
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700">Estado / Ubicación</label>
                <select name="estado" class="w-full border rounded-xl px-4 py-3 mt-2 focus:outline-none focus:ring-2 focus:ring-sky-300">
                  <% paqueteriasCatalog.forEach(function(option) { %>
                    <option value="<%= option %>"><%= option %></option>
                  <% }); %>
                </select>
              </div>
              <button type="submit" class="btn-brand w-full rounded-xl px-4 py-3 font-semibold">Crear paquete</button>
            </form>
          </div>

          <div class="overflow-auto">
            <table class="min-w-full text-sm border-separate" style="border-spacing: 0 10px;">
              <thead>
                <tr class="text-left text-gray-600 text-xs">
                  <th class="px-4 py-2">Folio</th>
                  <th class="px-4 py-2">Destino</th>
                  <th class="px-4 py-2">Peso</th>
                  <th class="px-4 py-2">Estado</th>
                </tr>
              </thead>
              <tbody>
                <% if (paquetes && paquetes.length > 0) { %>
                  <% paquetes.forEach(function(paquete) { %>
                    <tr class="bg-white rounded-lg shadow-sm mb-2" style="display: table-row;">
                      <td class="px-4 py-3 align-top"><span class="font-medium"><%= paquete.folio %></span></td>
                      <td class="px-4 py-3 align-top text-gray-600"><%= paquete.destino %></td>
                      <td class="px-4 py-3 align-top"><%= paquete.peso %> kg</td>
                      <td class="px-4 py-3 align-top">
                        <% if (paquete.estado === 'En Recolección') { %>
                          <span class="inline-block px-3 py-1 rounded-full text-xs bg-yellow-100 text-yellow-800">En Recolección</span>
                        <% } else if (paquete.estado === 'En Ruta') { %>
                          <span class="inline-block px-3 py-1 rounded-full text-xs bg-blue-100 text-blue-800">En Ruta</span>
                        <% } else if (paquete.estado === 'Entregado') { %>
                          <span class="inline-block px-3 py-1 rounded-full text-xs bg-green-100 text-green-800">Entregado</span>
                        <% } else { %>
                          <span class="inline-block px-3 py-1 rounded-full text-xs bg-gray-100 text-gray-700"><%= paquete.estado %></span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td class="px-4 py-4" colspan="4">No hay paquetes registrados.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <aside class="bg-white rounded-3xl p-6 card soft-shadow">
          <h3 class="text-xl font-semibold color1">Acciones rápidas</h3>
          <p class="mt-2 text-gray-500 text-sm">Administra paquetes existentes o elimina registros completados.</p>

          <form action="/admin/actualizar?rol=admin&auth=true" method="POST" class="space-y-4 mt-6">
            <div>
              <label class="block text-sm font-medium text-gray-700">Folio</label>
              <input name="folio" type="text" placeholder="ST-98231" class="w-full border rounded-xl px-4 py-3 mt-2 focus:outline-none focus:ring-2 focus:ring-sky-300" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700">Nueva ubicación / estado</label>
              <select name="estado" class="w-full border rounded-xl px-4 py-3 mt-2 focus:outline-none focus:ring-2 focus:ring-sky-300">
                <% paqueteriasCatalog.forEach(function(option) { %>
                  <option value="<%= option %>"><%= option %></option>
                <% }); %>
              </select>
            </div>
            <button type="submit" class="btn-brand w-full rounded-xl px-4 py-3 font-semibold">Actualizar estado</button>
          </form>

          <div class="mt-6 rounded-3xl border border-slate-200 p-5 bg-slate-50">
            <h4 class="text-lg font-semibold text-slate-900">Eliminar paquete</h4>
            <form action="/admin/eliminar?rol=admin&auth=true" method="POST" class="space-y-4 mt-4">
              <div>
                <label class="block text-sm font-medium text-gray-700">Folio</label>
                <input name="folio" type="text" placeholder="ST-1002" class="w-full border rounded-xl px-4 py-3 mt-2 focus:outline-none focus:ring-2 focus:ring-sky-300" />
              </div>
              <button type="submit" class="btn-brand w-full rounded-xl px-4 py-3 font-semibold">Eliminar paquete</button>
            </form>
          </div>

          <div class="mt-6">
            <h4 class="font-medium text-gray-900">Resumen rápido</h4>
            <ul class="mt-3 text-sm text-gray-600 space-y-2">
              <li>Total paquetes: <strong><%= paquetes ? paquetes.length : 0 %></strong></li>
              <li>En Ruta: <strong><%= paquetes ? paquetes.filter(p => p.estado === 'En Ruta').length : 0 %></strong></li>
              <li>Entregados: <strong><%= paquetes ? paquetes.filter(p => p.estado === 'Entregado').length : 0 %></strong></li>
            </ul>
          </div>
        </aside>
      </section>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
